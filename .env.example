# Copia este archivo a .env y completa los valores para desarrollo local.
# En producción (Render) estas variables se configuran en render.yaml / el dashboard.

# Flask
FLASK_SECRET_KEY=
PORT=5001

# Siembra Bot (Groq LLM + voz)
GROQ_API_KEY=

# Auth (Siembra Snap / AWS Cognito)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AWS (subida de imágenes de Siembra Snap a S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=siembrasnap-prod-2026

# MongoDB (lecturas de Siembra Link: fuente del motor de predicción de Siembra+)
# Si se deja vacío, la app funciona igual pero Siembra Link no persiste datos
# y /siembra-mas muestra "sin datos" hasta que se configure.
MONGODB_URI=
MONGODB_DB_NAME=siembramas

# Reverse geocoding (Nominatim/OpenStreetMap) — requerido por su política de uso
NOMINATIM_USER_AGENT=SiembraMas/1.0 (tu_correo@ejemplo.com)
